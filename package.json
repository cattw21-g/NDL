{
  "name": "ndl-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "set ENABLE_DEMO_SEED=true&& set NDL_SEED_RESET=true&& prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "points:recalculate": "tsx scripts/recalculate-points.ts",
    "bot:dev": "npm.cmd --prefix bot run dev",
    "bot:build": "npm.cmd --prefix bot run build",
    "bot:register": "npm.cmd --prefix bot run register-commands",
    "discord:register": "tsx scripts/register-discord-commands.ts",
    "discord:setup-server": "tsx scripts/setup-discord-server.ts",
    "discord:profile": "tsx scripts/update-bot-profile.ts",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.27.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
