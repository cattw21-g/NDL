{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nerfeddemonlist",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "83ae0f251236416a8294d2bd6908ca65"
		}
	],
	"vars": {
		"APP_URL": "https://www.nerfeddemonlist.net",
		"NEXT_PUBLIC_SITE_URL": "https://www.nerfeddemonlist.net"
	},
	"routes": [
		{
			"pattern": "nerfeddemonlist.net",
			"custom_domain": true
		},
		{
			"pattern": "www.nerfeddemonlist.net",
			"custom_domain": true
		},
		{
			"pattern": "beta.nerfeddemonlist.net",
			"custom_domain": true
		}
	]
}
